{
  "uid": "bnpb-m2",
  "title": "BNPB Gateway — M2 reliability",
  "tags": ["bnpb", "m2", "resilience"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sensor breaker (0 closed / 1 half / 2 open)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "max(sensor_breaker_state{source=\"SENSOR_PANTAI\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}, "unit": "none"}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Seconds since a genuinely new observation",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "max(sensor_seconds_since_last_fresh_observation{source=\"SENSOR_PANTAI\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 45}, {"color": "red", "value": 90}]}}, "overrides": []}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Critical alert p95 e2e (target < 5 s)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(critical_alert_pipeline_seconds_bucket{source=\"SENSOR_PANTAI\"}[5m])) by (le))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 3}, {"color": "red", "value": 5}]}}, "overrides": []}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fenced writes (stale leader rejected)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "sum(increase(fenced_writes_total[5m])) + sum(increase(storage_fenced_writes_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Lease epoch per source",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 5},
      "targets": [{"expr": "max(lease_epoch) by (source)", "legendFormat": "{{source}}", "refId": "A"}]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Lease transitions",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 5},
      "targets": [{"expr": "sum(rate(lease_transitions_total[5m])) by (source, event)", "legendFormat": "{{source}} {{event}}", "refId": "A"}]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Sensor requests by outcome",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "sum(rate(sensor_requests_total[5m])) by (operation, outcome)", "legendFormat": "{{operation}} {{outcome}}", "refId": "A"}]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Sensor request p95 latency",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 12},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(sensor_request_duration_seconds_bucket[5m])) by (le, operation))", "legendFormat": "{{operation}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "DLQ parked by reason",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 19},
      "targets": [{"expr": "sum(increase(dlq_parked_total{source=\"SENSOR_PANTAI\"}[5m])) by (reason)", "legendFormat": "{{reason}}", "refId": "A"}]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Outbox: enqueued vs delivered",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 19},
      "targets": [
        {"expr": "sum(increase(critical_outbox_enqueued_total[5m]))", "legendFormat": "enqueued", "refId": "A"},
        {"expr": "sum(increase(critical_outbox_delivered_total{outcome=\"delivered\"}[5m]))", "legendFormat": "delivered", "refId": "B"},
        {"expr": "sum(increase(critical_outbox_delivered_total{outcome=\"retry\"}[5m]))", "legendFormat": "retries", "refId": "C"}
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Coordinator outbox depth",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 26},
      "targets": [{"expr": "max(coordinator_outbox_entries) by (status)", "legendFormat": "{{status}}", "refId": "A"}]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Controlled rejections by role",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 26},
      "targets": [{"expr": "sum(rate(admission_rejected_total[5m])) by (role, reason)", "legendFormat": "{{role}} {{reason}}", "refId": "A"}]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Aggregator in-flight + request rate",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 26},
      "targets": [
        {"expr": "sum(http_in_flight_requests{service=\"aggregator\"})", "legendFormat": "in-flight", "refId": "A"},
        {"expr": "sum(rate(http_requests_total{service=\"aggregator\"}[1m]))", "legendFormat": "req/s", "refId": "B"}
      ]
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Read API p95 by route",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 33},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"aggregator\"}[5m])) by (le, route))", "legendFormat": "{{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "HTTP outcomes (success / error / shed)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 33},
      "targets": [{"expr": "sum(rate(http_requests_total[5m])) by (service, outcome)", "legendFormat": "{{service}} {{outcome}}", "refId": "A"}]
    },
    {
      "id": 50,
      "type": "timeseries",
      "title": "Storage upserts by result",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 40},
      "targets": [{"expr": "sum(rate(storage_upserts_total[5m])) by (result)", "legendFormat": "{{result}}", "refId": "A"}]
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "Checkpoint CAS results",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 40},
      "targets": [{"expr": "sum(rate(coordinator_checkpoint_commits_total[5m])) by (source, result)", "legendFormat": "{{source}} {{result}}", "refId": "A"}]
    },
    {
      "id": 60,
      "type": "timeseries",
      "title": "Sensor queue depth (bounded)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 47},
      "targets": [{"expr": "max(sensor_queue_depth) by (queue)", "legendFormat": "{{queue}}", "refId": "A"}]
    },
    {
      "id": 61,
      "type": "timeseries",
      "title": "Critical alert e2e histogram quantiles",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 47},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(critical_alert_pipeline_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(critical_alert_pipeline_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(critical_alert_pipeline_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    }
  ]
}
