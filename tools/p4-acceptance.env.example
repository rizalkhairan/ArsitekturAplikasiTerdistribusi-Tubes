# Source a private copy before running tools/p3-p4-kubernetes-test.sh.
# Never store tokens in this file.
export KUBECONFIG=/path/to/demo-kubeconfig
export NAMESPACE=sistem-informasi-kebencanaan-bnpb
export P4_REFERENCE_FILE=/path/to/assistant-reference.json
export P4_LOAD_SCRIPT=/path/to/assistant-workload-adapter.sh
export P4_LIVE_SECONDS=180
# The adapter invokes the official workload, waits for completion, and writes
# the actual workload receipt to $P4_LOAD_RECEIPT:
# {"speed":60,"final_offset":12345,"ended_at_unix":1790000000}
# ended_at_unix is the time the burst ended, not when processing caught up.
# Reference JSON shape: {"fires":[canonical HazardEvent objects...]}
